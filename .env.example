# ==============================================================================
# Server Environment Variables (Backend Deployment Only - Never commit secrets)
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
MONGODB_DATABASE=UserInfo
MONGODB_COLLECTION=ContactDetails
PORT=5000
ALLOWED_ORIGINS=https://www.sangrillagroup.com,https://sangrillagroup.com,http://localhost:5173

# ==============================================================================
# Frontend Environment Variable (Publicly exposed by Vite)
# Set to your deployed backend URL for GitHub Pages builds
# Example: https://sangrilla-api.onrender.com or https://sangrilla-api.vercel.app
# ==============================================================================
VITE_API_BASE_URL=
